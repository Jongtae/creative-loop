# Default: no external API calls. Keep .env local; never commit it.
DATA_DIR=data
APP_TOKEN=
ALLOWED_HOSTS=127.0.0.1,localhost,::1
ALLOW_EXTERNAL_AI=0
OPENAI_API_KEY=
# Explicitly choose models available to your API account. No model is assumed.
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=
# Shared UTC daily request cap, including failed requests. Not a currency budget.
MAX_PROVIDER_CALLS_PER_DAY=20
